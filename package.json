{
  "name": "snplanner",
  "version": "0.2.3",
  "description": "Supernote plugin: linked yearly planner (year/quarter/month/week/day) with ✓ marks for days that have notes.",
  "private": true,
  "scripts": {
    "build": "./buildPlugin.sh",
    "lint": "eslint .",
    "start": "react-native start",
    "preview": "node tools/dump_ops.js 2027 build/preview.json && python3 tools/preview.py build/preview.json build/preview --marks",
    "test": "node tools/test.js"
  },
  "dependencies": {
    "react": "19.0.0",
    "react-native": "0.79.2",
    "sn-plugin-lib": "^0.2.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "18.0.0",
    "@react-native-community/cli-platform-android": "18.0.0",
    "@react-native/babel-preset": "0.79.2",
    "@react-native/eslint-config": "0.79.2",
    "@react-native/metro-config": "0.79.2",
    "@react-native/typescript-config": "0.79.2",
    "@types/react": "^19.0.0",
    "eslint": "^8.19.0",
    "prettier": "2.8.8",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
